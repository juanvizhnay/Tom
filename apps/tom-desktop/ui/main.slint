    if root.onboarding-visible : Rectangle {
        z: 110;
        background: Theme.canvas;

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 920px;
            height: 590px;
            border-radius: 16px;
            border-width: 1px;
