            background: Theme.ink;

            Rectangle {
                width: 286px;
                height: parent.height;
                border-radius: 16px;
                background: Theme.canvas;

                OrbVisual {
                    x: 54px;
                    y: 42px;
                    width: 178px;
                    height: 178px;
                    state: root.onboarding-step == 0 ? "curious"
                        : root.onboarding-step == 4 ? "thinking" : root.orb-state;
                }

                Text {
                    x: 32px;
                    y: 226px;
                    width: parent.width - 64px;
                    height: 24px;
                    text: root.assistant-name;
