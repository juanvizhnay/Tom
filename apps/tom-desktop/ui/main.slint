                        color: Theme.text-secondary; font-size: 11px;
                    }
                    Text {
                        x: 24px; y: 154px; width: parent.width - 48px; height: 28px;
                        text: "03   IA local o cloud elegida por ti";
                        color: Theme.text-secondary; font-size: 11px;
                    }
                    Text {
                        x: 24px; y: 196px; width: parent.width - 48px; height: 28px;
                        text: "04   Un orbe discreto cuando no necesites el panel";
                        color: Theme.text-secondary; font-size: 11px;
                    }
                }

                if root.onboarding-step == 1 : Rectangle {
                    x: 42px; y: 142px; width: parent.width - 84px; height: 250px; background: transparent;

                    OnboardingChoice {
                        y: 0px; width: parent.width; height: 104px;
                        choice-id: "professional"; label: "Tom";
                        detail: "Sereno, compacto y directo. Ideal cuando quieres foco y lenguaje profesional.";
                        selected: root.selected-persona == self.choice-id;
                        chosen(id) => { root.selected-persona = id; root.assistant-name = "Tom"; }
                    }
                    OnboardingChoice {
                        y: 120px; width: parent.width; height: 104px;
                        choice-id: "friendly"; label: "Tomy";
                        detail: "Cercano, cálido y alentador. El mismo criterio con una energía más relajada.";
                        selected: root.selected-persona == self.choice-id;
                        chosen(id) => { root.selected-persona = id; root.assistant-name = "Tomy"; }
                    }
                }

                if root.onboarding-step == 2 : Rectangle {
                    x: 42px; y: 138px; width: parent.width - 84px; height: 310px; background: transparent;

                    OnboardingChoice { x: 0px; y: 0px; width: 244px; choice-id: "developer"; label: "Desarrollo"; detail: "Código, Git, terminal y proyectos"; selected: root.selected-profession == self.choice-id; chosen(id) => { root.selected-profession = id; } }
                    OnboardingChoice { x: 260px; y: 0px; width: 244px; choice-id: "office"; label: "Oficina"; detail: "Documentos, reuniones y seguimiento"; selected: root.selected-profession == self.choice-id; chosen(id) => { root.selected-profession = id; } }
                    OnboardingChoice { x: 0px; y: 92px; width: 244px; choice-id: "student"; label: "Estudio"; detail: "Lecturas, entregas y aprendizaje"; selected: root.selected-profession == self.choice-id; chosen(id) => { root.selected-profession = id; } }
                    OnboardingChoice { x: 260px; y: 92px; width: 244px; choice-id: "creator"; label: "Creación"; detail: "Ideas, contenido y producción"; selected: root.selected-profession == self.choice-id; chosen(id) => { root.selected-profession = id; } }
                    OnboardingChoice { x: 0px; y: 184px; width: 504px; choice-id: "general"; label: "Uso general"; detail: "Organización diaria sin una profesión dominante"; selected: root.selected-profession == self.choice-id; chosen(id) => { root.selected-profession = id; } }
                }

                if root.onboarding-step == 3 : Rectangle {
                    x: 42px; y: 142px; width: parent.width - 84px; height: 310px; background: transparent;

                    OnboardingChoice { y: 0px; width: parent.width; choice-id: "focused"; label: "Enfocado"; detail: "Sólo responde y recuerda cuando se lo pidas."; selected: root.selected-assistance == self.choice-id; chosen(id) => { root.selected-assistance = id; } }
                    OnboardingChoice { y: 92px; width: parent.width; choice-id: "balanced"; label: "Equilibrado"; detail: "Sugiere ayudas cuando el patrón es claro, sin interrumpir."; selected: root.selected-assistance == self.choice-id; chosen(id) => { root.selected-assistance = id; } }
                    OnboardingChoice { y: 184px; width: parent.width; choice-id: "proactive"; label: "Proactivo"; detail: "Busca oportunidades y prepara acciones para que tú las apruebes."; selected: root.selected-assistance == self.choice-id; chosen(id) => { root.selected-assistance = id; } }
                }

                if root.onboarding-step == 4 : Rectangle {
                    x: 42px; y: 142px; width: parent.width - 84px; height: 310px; background: transparent;

                    OnboardingChoice { y: 0px; width: parent.width; choice-id: "later"; label: "Configurar después"; detail: "Entra a Tom sin proveedor; memoria y notas siguen disponibles."; selected: root.selected-ai-setup == self.choice-id; chosen(id) => { root.selected-ai-setup = id; } }
                    OnboardingChoice { y: 92px; width: parent.width; choice-id: "cloud"; label: "Proveedor cloud"; detail: "OpenAI, Anthropic, Gemini o endpoint compatible con tu API key."; selected: root.selected-ai-setup == self.choice-id; chosen(id) => { root.selected-ai-setup = id; } }
                    OnboardingChoice { y: 184px; width: parent.width; choice-id: "local"; label: "Modelo local"; detail: "Ollama, LM Studio o un endpoint/modelo propio en este PC."; selected: root.selected-ai-setup == self.choice-id; chosen(id) => { root.selected-ai-setup = id; } }
                }

                if root.onboarding-step > 0 : QuietButton {
                    x: 42px;
                    y: parent.height - 66px;
                    width: 104px;
                    label: "Atrás";
                    compact: true;
                    clicked => { root.onboarding-step -= 1; }
                }

                QuietButton {
                    x: parent.width - 184px;
                    y: parent.height - 72px;
                    width: 142px;
                    label: root.onboarding-step == 0 ? "Conocernos"
                        : root.onboarding-step == 4 ? "Terminar" : "Continuar";
                    primary: true;
                    clicked => {
                        if root.onboarding-step < 4 {
                            root.onboarding-step += 1;
                        } else {
                            root.onboarding-completed(root.selected-persona, root.selected-profession, root.selected-assistance);
                            root.onboarding-visible = false;
                            if root.selected-ai-setup == "cloud" {
                                root.ai-provider = "openai";
                                root.settings-visible = true;
                            } else if root.selected-ai-setup == "local" {
                                root.ai-provider = "ollama";
                                root.settings-visible = true;
                            }
                        }
                    }
                }

                Text {
                    x: 42px;
                    y: parent.height - 28px;
                    width: parent.width - 84px;
                    height: 12px;
                    text: "Built with Slint";
                    color: Theme.text-muted;
                    font-size: 8px;
                    horizontal-alignment: right;
                }
            }
        }
    }

    if root.settings-visible : Rectangle {
        z: 120;
        background: #0d0f14ed;

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 820px;
            height: 580px;
            border-radius: 16px;
            border-width: 1px;
            border-color: Theme.border;
            background: Theme.graphite;

            Text {
                x: 28px;
                y: 24px;
                width: 420px;
                height: 28px;
                text: "Inteligencia artificial";
                color: Theme.paper;
                font-family: "Segoe UI Variable Display";
                font-size: 20px;
                font-weight: 650;
            }

            Text {
                x: 28px;
                y: 56px;
                width: 660px;
                height: 32px;
                text: "Conecta un proveedor de nube o un modelo que ya se ejecute en tu PC.";
                color: Theme.text-tertiary;
                font-size: 11px;
                wrap: word-wrap;
            }

            SectionLabel { x: 28px; y: 104px; width: 180px; height: 16px; label: "Modelos en la nube"; }

            ProviderOption {
                x: 28px; y: 128px; width: 176px;
                provider-id: "openai"; label: "OpenAI"; detail: "API key propia";
                selected: root.ai-provider == self.provider-id;
                chosen(id) => { root.ai-provider = id; }
            }
            ProviderOption {
                x: 214px; y: 128px; width: 176px;
                provider-id: "anthropic"; label: "Anthropic"; detail: "Claude con tu clave";
                selected: root.ai-provider == self.provider-id;
                chosen(id) => { root.ai-provider = id; }
            }
            ProviderOption {
                x: 400px; y: 128px; width: 176px;
                provider-id: "gemini"; label: "Gemini"; detail: "Google AI";
                selected: root.ai-provider == self.provider-id;
                chosen(id) => { root.ai-provider = id; }
            }
            ProviderOption {
                x: 586px; y: 128px; width: 206px;
                provider-id: "custom-cloud"; label: "Cloud compatible"; detail: "Endpoint personalizado";
                selected: root.ai-provider == self.provider-id;
                chosen(id) => { root.ai-provider = id; }
            }

            SectionLabel { x: 28px; y: 202px; width: 180px; height: 16px; label: "Modelos locales"; }

            ProviderOption {
                x: 28px; y: 226px; width: 238px;
                provider-id: "ollama"; label: "Ollama"; detail: "Local · endpoint automático";
                selected: root.ai-provider == self.provider-id;
                chosen(id) => { root.ai-provider = id; }
            }
            ProviderOption {
                x: 276px; y: 226px; width: 238px;
                provider-id: "lm-studio"; label: "LM Studio"; detail: "Servidor local compatible";
                selected: root.ai-provider == self.provider-id;
                chosen(id) => { root.ai-provider = id; }
            }
            ProviderOption {
                x: 524px; y: 226px; width: 268px;
                provider-id: "custom-local"; label: "Local personalizado"; detail: "Endpoint o ruta de modelo";
                selected: root.ai-provider == self.provider-id;
                chosen(id) => { root.ai-provider = id; }
            }

            SectionLabel { x: 28px; y: 304px; width: 240px; height: 16px; label: "Conexión"; }

            Text {
                x: 28px; y: 330px; width: 360px; height: 16px;
                text: root.ai-provider == "ollama" || root.ai-provider == "lm-studio" || root.ai-provider == "custom-local"
                    ? "Endpoint local" : "Endpoint compatible (opcional)";
                color: Theme.text-secondary; font-size: 10px; font-weight: 600;
            }
            QuietInput {
                x: 28px; y: 350px; width: 366px; height: 38px;
                value <=> root.local-endpoint;
                placeholder: root.ai-provider == "ollama" ? "http://127.0.0.1:11434" : "https://… o http://127.0.0.1:…";
            }

            Text {
                x: 410px; y: 330px; width: 382px; height: 16px;
                text: "Modelo o ruta local";
                color: Theme.text-secondary; font-size: 10px; font-weight: 600;
            }
            QuietInput {
                x: 410px; y: 350px; width: 382px; height: 38px;
                value <=> root.local-model-path;
                placeholder: "llama3.2, qwen… o C:\\modelos\\modelo.gguf";
            }

            Text {
                x: 28px; y: 408px; width: 300px; height: 16px;
                text: "API key" + (root.has-api-key ? " · guardada" : "");
                color: root.has-api-key ? Theme.process : Theme.text-secondary;
                font-size: 10px; font-weight: 600;
            }
            QuietInput {
                x: 28px; y: 428px; width: 506px; height: 38px;
                value <=> root.api-key-input;
                placeholder: root.has-api-key ? "Deja vacío para conservar la clave actual" : "Pega tu clave; no se mostrará de nuevo";
                secret: true;
            }

            if root.has-api-key : QuietButton {
                x: 546px; y: 431px; width: 120px;
                label: "Borrar clave"; compact: true;
                clicked => {
                    root.clear-api-key();
                    root.api-key-input = "";
                }
            }

            Text {
                x: 28px; y: 482px; width: 540px; height: 32px;
                text: "Las claves se guardan en Windows Credential Manager. Nunca se escriben en SQLite, Git ni archivos del proyecto.";
                color: Theme.text-muted; font-size: 9px; wrap: word-wrap;
            }

            QuietButton {
                x: 28px; y: 526px; width: 126px;
                label: "Desactivar IA"; compact: true;
                clicked => { root.ai-provider = "disabled"; }
            }

            QuietButton {
                x: 164px; y: 526px; width: 154px;
                label: "Repetir bienvenida"; compact: true;
                clicked => {
                    root.settings-visible = false;
                    root.onboarding-step = 0;
                    root.onboarding-visible = true;
                }
            }

            QuietButton {
                x: parent.width - 280px; y: 526px; width: 102px;
                label: "Cerrar"; compact: true;
                clicked => { root.settings-visible = false; }
            }

            QuietButton {
                x: parent.width - 168px; y: 520px; width: 140px;
                label: "Guardar conexión"; primary: true;
                clicked => {
                    root.save-ai-settings(root.ai-provider, root.api-key-input, root.local-endpoint, root.local-model-path);
                    root.api-key-input = "";
                    root.settings-visible = false;
                }
            }
        }
    }
}

export component OrbWindow inherits Window {
    in-out property <string> assistant-name: "Tom";
    in-out property <string> orb-state: "idle";
    in-out property <int> orb-size: 176;
    property <bool> controls-visible: orb-touch.has-hover || shrink-touch.has-hover || grow-touch.has-hover;
    callback restore-dashboard();
    callback drag-orb(float, float);
    callback resize-orb(string);

    title: assistant-name + " — modo orbe";
    preferred-width: root.orb-size * 1px;
    preferred-height: root.orb-size * 1px;
    min-width: 96px;
    min-height: 96px;
    max-width: 288px;
    max-height: 288px;
    no-frame: true;
    always-on-top: true;
    background: transparent;

    Rectangle {
        x: 4px;
        y: 4px;
        width: parent.width - 8px;
        height: parent.height - 8px;
        border-radius: self.width / 2;
        background: root.controls-visible ? #171a227d : transparent;

        OrbVisual {
            x: 4px;
            y: 4px;
            width: parent.width - 8px;
            height: parent.height - 8px;
            state: root.orb-state;
        }

        orb-touch := TouchArea {
            property <bool> dragged: false;
            accessible-role: button;
            accessible-label: "Arrastrar o restaurar " + root.assistant-name;
            mouse-cursor: move;

            pointer-event(event) => {
                if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                    self.dragged = false;
                }
            }
            moved => {
                if (self.pressed && (abs(self.mouse-x - self.pressed-x) > 1px || abs(self.mouse-y - self.pressed-y) > 1px)) {
                    self.dragged = true;
                    root.drag-orb(
                        (self.mouse-x - self.pressed-x) / 1px,
                        (self.mouse-y - self.pressed-y) / 1px
                    );
                }
            }
            clicked => {
                if (!self.dragged) {
                    root.restore-dashboard();
                }
            }
            scroll-event(event) => {
                if (event.delta-y != 0px) {
                    root.resize-orb(event.delta-y > 0px ? "larger" : "smaller");
                    return accept;
                }
                reject
            }
        }

        Rectangle {
            x: 12px;
            y: parent.height - 36px;
            width: 24px;
            height: 24px;
            border-radius: 12px;
            border-width: root.controls-visible ? 1px : 0px;
            border-color: Theme.border;
            background: root.controls-visible ? #0d0f14e6 : transparent;

            Text {
                text: "−";
                color: root.controls-visible ? (root.orb-size > 96 ? Theme.paper : Theme.text-muted) : transparent;
                font-size: 14px;
                font-weight: 650;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            shrink-touch := TouchArea {
                enabled: root.orb-size > 96;
                accessible-role: button;
                accessible-label: "Reducir tamaño del orbe";
                mouse-cursor: pointer;
                clicked => { root.resize-orb("smaller"); }
            }
        }

        Rectangle {
            x: parent.width - 36px;
            y: parent.height - 36px;
            width: 24px;
            height: 24px;
            border-radius: 12px;
            border-width: root.controls-visible ? 1px : 0px;
            border-color: Theme.border;
            background: root.controls-visible ? #0d0f14e6 : transparent;

            Text {
                text: "+";
                color: root.controls-visible ? (root.orb-size < 288 ? Theme.paper : Theme.text-muted) : transparent;
                font-size: 14px;
                font-weight: 650;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            grow-touch := TouchArea {
                enabled: root.orb-size < 288;
                accessible-role: button;
                accessible-label: "Aumentar tamaño del orbe";
                mouse-cursor: pointer;
                clicked => { root.resize-orb("larger"); }
            }
        }
    }
}
