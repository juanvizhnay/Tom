                    letter-spacing: 1px;
                }

                persona-tom := TouchArea {
                    accessible-role: radio-button;
                    accessible-label: "Elegir personalidad Tom, profesional";
                    clicked => {
                        root.selected-persona = "professional";
                        root.assistant-name = "Tom";
                    }
                }
