                    font-size: 10px;
                    font-weight: 600;
                }

                Text {
                    x: 20px;
                    y: 82px;
                    width: parent.width - 40px;
                    height: 52px;
                    text: "Respuestas compactas, lenguaje profesional y propuestas explicadas antes de actuar.";
