// Tom's visual language is intentionally quiet: one work surface, low-contrast
// boundaries, and color reserved for intent (lavender) or confirmed progress (green).

global Theme {
    out property <color> canvas: #0d0f14;
    out property <color> ink: #11141a;
    out property <color> graphite: #161a21;
    out property <color> graphite-raised: #1a1f27;
    out property <color> inset: #0b0d12;

    out property <color> paper: #e8e8e4;
    out property <color> text-secondary: #a8abb3;
    out property <color> text-tertiary: #737985;
    out property <color> text-muted: #4e5561;

    out property <color> border-soft: #252a33;
    out property <color> border: #303641;
    out property <color> border-focus: #777293;

    out property <color> lavender: #aaa4c8;
    out property <color> lavender-soft: #2a2837;
    out property <color> lavender-hover: #bab4d5;
    out property <color> process: #79a88b;
    out property <color> process-soft: #1c2b24;
    out property <color> warning: #b9a16f;
}

export struct MemoryRow {
    title: string,
    preview: string,
    meta: string,
}

export struct RoutineRow {
    title: string,
    explanation: string,
    action: string,
}

// Rows below are built in Rust from the assistant's catalog. The interface never invents
// a label or an id: it renders what it is handed and sends the same id straight back.
export struct ChoiceRow {
    id: string,
    label: string,
    detail: string,
}

export struct PulseRow {
    stage: string,
    title: string,
    detail: string,
    time: string,
    tone-id: string,
}

export struct OnboardingPage {
    rail-label: string,
    headline: string,
    body: string,
    caption: string,
    primary-label: string,
}

export struct ChatRow {
    role: string,
    text: string,
}

export struct ApiKeyRow {
    provider-id: string,
    label: string,
    detail: string,
    stored: bool,
}

component OrbVisual inherits Rectangle {
    in property <string> state: "idle";
    background: transparent;

    Image {
        width: parent.width;
        height: parent.height;
        image-fit: contain;
        source: root.state == "listening" ? @image-url("../assets/orb-states/listening.png")
            : root.state == "thinking" ? @image-url("../assets/orb-states/thinking.png")
            : root.state == "working" ? @image-url("../assets/orb-states/working.png")
            : root.state == "success" ? @image-url("../assets/orb-states/success.png")
            : root.state == "warning" ? @image-url("../assets/orb-states/warning.png")
            : root.state == "error" ? @image-url("../assets/orb-states/error.png")
            : root.state == "sleeping" ? @image-url("../assets/orb-states/sleeping.png")
            : root.state == "curious" ? @image-url("../assets/orb-states/curious.png")
            : @image-url("../assets/orb-states/idle.png");
    }
}

component OnboardingChoice inherits Rectangle {
    in property <ChoiceRow> choice;
    in property <bool> selected: false;
    callback chosen(string);

    height: 76px;
    border-radius: 10px;
    border-width: 1px;
    border-color: root.selected ? Theme.lavender : Theme.border-soft;
    background: onboarding-choice-touch.has-hover ? Theme.graphite-raised : Theme.graphite;

    Rectangle {
        x: 14px;
        y: (parent.height - 18px) / 2;
        width: 18px;
        height: 18px;
        border-radius: 9px;
        border-width: 1px;
        border-color: root.selected ? Theme.lavender : Theme.border;
        background: root.selected ? Theme.lavender-soft : Theme.inset;

        Rectangle {
            x: 5px;
            y: 5px;
            width: 8px;
            height: 8px;
            border-radius: 4px;
            background: root.selected ? Theme.lavender : transparent;
        }
    }

    Text {
        x: 44px;
        y: 13px;
        width: parent.width - 58px;
        height: 20px;
        text: root.choice.label;
        color: root.selected ? Theme.paper : Theme.text-secondary;
        font-size: 12px;
        font-weight: 650;
    }

    Text {
        x: 44px;
        y: 36px;
        width: parent.width - 58px;
        height: 28px;
        text: root.choice.detail;
        color: Theme.text-tertiary;
        font-size: 9px;
        wrap: word-wrap;
    }

    onboarding-choice-touch := TouchArea {
        accessible-role: radio-button;
        accessible-label: root.choice.label;
        clicked => { root.chosen(root.choice.id); }
    }
}

component NavItem inherits Rectangle {
    in property <string> glyph;
    in property <string> label;
    in property <bool> selected: false;
    callback activated();

    height: 48px;
    border-radius: 8px;
    background: selected ? Theme.graphite-raised : (nav-touch.has-hover ? Theme.graphite : transparent);

    Rectangle {
        x: 0px;
        y: 12px;
        width: 2px;
        height: 24px;
        border-radius: 1px;
        background: root.selected ? Theme.lavender : transparent;
    }

    Text {
        x: 18px;
        y: 8px;
        width: 28px;
        height: 18px;
        text: root.glyph;
        color: root.selected ? Theme.paper : Theme.text-tertiary;
        font-family: "Segoe UI Symbol";
        font-size: 15px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    Text {
        x: 8px;
        y: 30px;
        width: parent.width - 16px;
        height: 12px;
        text: root.label;
        color: root.selected ? Theme.text-secondary : Theme.text-muted;
        font-size: 9px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    nav-touch := TouchArea {
        accessible-role: button;
        accessible-label: root.label;
        clicked => { root.activated(); }
    }
}

component QuietButton inherits Rectangle {
    in property <string> label;
    in property <bool> primary: false;
    in property <bool> compact: false;
    callback clicked();

    min-width: compact ? 92px : 116px;
    height: compact ? 32px : 38px;
    border-radius: 7px;
    border-width: 1px;
    border-color: primary ? Theme.lavender : Theme.border;
    background: primary
        ? (button-touch.has-hover ? Theme.lavender-hover : Theme.lavender)
        : (button-touch.has-hover ? Theme.graphite-raised : Theme.graphite);

    Text {
        text: root.label;
        color: root.primary ? Theme.canvas : Theme.text-secondary;
        font-size: root.compact ? 11px : 12px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    button-touch := TouchArea {
        accessible-role: button;
        accessible-label: root.label;
        clicked => { root.clicked(); }
    }
}

component QuietInput inherits Rectangle {
    in-out property <string> value;
    in property <string> placeholder;
    in property <bool> multiline: false;
    in property <bool> secret: false;
    forward-focus: editor;

    border-radius: 8px;
    border-width: 1px;
    border-color: editor.has-focus ? Theme.border-focus : Theme.border-soft;
    background: Theme.inset;
    clip: true;

    if root.value == "" : Text {
        x: 14px;
        y: root.multiline ? 12px : 0px;
        width: parent.width - 28px;
        height: root.multiline ? 20px : parent.height;
        text: root.placeholder;
        color: Theme.text-muted;
        font-size: 12px;
        vertical-alignment: root.multiline ? top : center;
    }

    editor := TextInput {
        x: 14px;
        y: root.multiline ? 10px : 0px;
        width: parent.width - 28px;
        height: root.multiline ? parent.height - 20px : parent.height;
        text <=> root.value;
        color: Theme.paper;
        font-family: "Segoe UI Variable Text";
        font-size: 12px;
        font-weight: 400;
        single-line: !root.multiline;
        input-type: root.secret ? password : text;
        wrap: root.multiline ? word-wrap : no-wrap;
        vertical-alignment: root.multiline ? top : center;
        selection-foreground-color: Theme.canvas;
        selection-background-color: Theme.lavender;
        accessible-label: root.placeholder;
    }
}

component ProviderOption inherits Rectangle {
    in property <ChoiceRow> provider;
    in property <bool> selected: false;
    callback chosen(string);

    height: 54px;
    border-radius: 8px;
    border-width: 1px;
    border-color: root.selected ? Theme.lavender : Theme.border-soft;
    background: provider-touch.has-hover ? Theme.graphite-raised : Theme.canvas;

    Text {
        x: 12px;
        y: 8px;
        width: parent.width - 24px;
        height: 18px;
        text: root.provider.label;
        color: root.selected ? Theme.paper : Theme.text-secondary;
        font-size: 11px;
        font-weight: 650;
    }

    Text {
        x: 12px;
        y: 28px;
        width: parent.width - 24px;
        height: 14px;
        text: root.provider.detail;
        color: Theme.text-muted;
        font-size: 9px;
        overflow: elide;
    }

    provider-touch := TouchArea {
        accessible-role: radio-button;
        accessible-label: root.provider.label;
        clicked => { root.chosen(root.provider.id); }
    }
}

// One provider in the key manager: what it is, whether a key is stored, and the two
// actions that exist. Selecting a row never writes or deletes anything.
component ApiKeyItem inherits Rectangle {
    in property <ApiKeyRow> entry;
    in property <bool> selected: false;
    callback chosen(string);
    callback forget(string);

    height: 46px;
    border-radius: 8px;
    border-width: 1px;
    border-color: root.selected ? Theme.lavender : Theme.border-soft;
    background: key-touch.has-hover || root.selected ? Theme.graphite-raised : Theme.canvas;

    key-touch := TouchArea {
        accessible-role: radio-button;
        accessible-label: root.entry.label;
        clicked => { root.chosen(root.entry.provider-id); }
    }

    Text {
        x: 14px;
        y: 7px;
        width: 180px;
        height: 16px;
        text: root.entry.label;
        color: Theme.paper;
        font-size: 12px;
        font-weight: 650;
        vertical-alignment: center;
    }

    Text {
        x: 14px;
        y: 25px;
        width: 260px;
        height: 14px;
        text: root.entry.detail;
        color: Theme.text-muted;
        font-size: 9px;
        overflow: elide;
        vertical-alignment: center;
    }

    Rectangle {
        x: 330px;
        y: 18px;
        width: 8px;
        height: 8px;
        border-radius: 4px;
        background: root.entry.stored ? Theme.process : Theme.border;
    }

    Text {
        x: 348px;
        y: 13px;
        width: 160px;
        height: 20px;
        text: root.entry.stored ? "Clave guardada" : "Sin clave";
        color: root.entry.stored ? Theme.process : Theme.text-muted;
        font-size: 10px;
        font-weight: 600;
        vertical-alignment: center;
    }

    if root.entry.stored : QuietButton {
        x: parent.width - 106px;
        y: 8px;
        width: 92px;
        label: "Borrar";
        compact: true;
        clicked => { root.forget(root.entry.provider-id); }
    }
}

// A turn of the conversation. The user's words sit right and tinted, the assistant's
// left and plain, so a glance tells you who said what without reading a label.
component ChatBubble inherits Rectangle {
    in property <ChatRow> turn;
    property <bool> mine: root.turn.role == "user";

    height: body.preferred-height + 28px;
    background: transparent;

    Rectangle {
        x: root.mine ? parent.width - self.width : 0px;
        width: min(parent.width * 0.82, max(body.preferred-width + 32px, 120px));
        height: parent.height - 8px;
        border-radius: 10px;
        border-width: 1px;
        border-color: root.mine ? Theme.lavender-soft : Theme.border-soft;
        background: root.mine ? Theme.lavender-soft : Theme.graphite;

        Text {
            x: 14px;
            y: 6px;
            width: parent.width - 28px;
            height: 12px;
            text: root.mine ? "TU" : root.turn.role == "assistant" ? "TOM" : "";
            color: root.mine ? Theme.lavender : Theme.text-muted;
            font-size: 8px;
            font-weight: 700;
            letter-spacing: 1px;
        }

        body := Text {
            x: 14px;
            y: 22px;
            width: parent.width - 28px;
            text: root.turn.text;
            color: Theme.paper;
            font-size: 12px;
            wrap: word-wrap;
        }
    }
}

component SectionLabel inherits Text {
    in property <string> label;
    text: label.to-uppercase();
    color: Theme.text-tertiary;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.2px;
    vertical-alignment: center;
}

component MemoryItem inherits Rectangle {
    in property <MemoryRow> memory;

    height: 76px;
    border-radius: 8px;
    background: memory-touch.has-hover ? Theme.graphite-raised : transparent;

    Rectangle {
        x: 0px;
        y: 13px;
        width: 3px;
        height: 36px;
        border-radius: 2px;
        background: Theme.border;
    }

    Text {
        x: 16px;
        y: 9px;
        width: parent.width - 28px;
        height: 19px;
        text: root.memory.title;
        color: Theme.paper;
        font-size: 12px;
        font-weight: 600;
        overflow: elide;
        vertical-alignment: center;
    }

    Text {
        x: 16px;
        y: 30px;
        width: parent.width - 28px;
        height: 17px;
        text: root.memory.preview;
        color: Theme.text-secondary;
        font-size: 11px;
        overflow: elide;
        vertical-alignment: center;
    }

    Text {
        x: 16px;
        y: 51px;
        width: parent.width - 28px;
        height: 13px;
        text: root.memory.meta;
        color: Theme.text-muted;
        font-size: 9px;
        font-weight: 500;
        overflow: elide;
        vertical-alignment: center;
    }

    memory-touch := TouchArea {
        accessible-role: list-item;
        accessible-label: root.memory.title;
    }
}

component PulseStep inherits Rectangle {
    in property <PulseRow> step;
    in property <bool> last: false;

    // The tone says which rung of the ladder this is: seen, inferred, or proposed.
    property <color> tone: root.step.tone-id == "inferred" ? Theme.lavender
        : root.step.tone-id == "proposed" ? Theme.process
        : Theme.text-tertiary;

    height: 92px;
    background: transparent;

    if !root.last : Rectangle {
        x: 9px;
        y: 24px;
        width: 1px;
        height: parent.height - 4px;
        background: Theme.border;
    }

    Rectangle {
        x: 5px;
        y: 12px;
        width: 9px;
        height: 9px;
        border-radius: 5px;
        border-width: 2px;
        border-color: root.tone;
        background: Theme.ink;
    }

    Text {
        x: 30px;
        y: 4px;
        width: parent.width - 92px;
        height: 16px;
        text: root.step.stage.to-uppercase();
        color: root.tone;
        font-size: 9px;
        font-weight: 700;
        letter-spacing: 1px;
        vertical-alignment: center;
    }

    Text {
        x: parent.width - 54px;
        y: 4px;
        width: 54px;
        height: 16px;
        text: root.step.time;
        color: Theme.text-muted;
        font-size: 9px;
        horizontal-alignment: right;
        vertical-alignment: center;
    }

    Text {
        x: 30px;
        y: 24px;
        width: parent.width - 30px;
        height: 18px;
        text: root.step.title;
        color: Theme.paper;
        font-size: 12px;
        font-weight: 600;
        overflow: elide;
        vertical-alignment: center;
    }

    Text {
        x: 30px;
        y: 46px;
        width: parent.width - 30px;
        height: 34px;
        text: root.step.detail;
        color: Theme.text-tertiary;
        font-size: 10px;
        wrap: word-wrap;
    }
}

component RoutineItem inherits Rectangle {
    in property <RoutineRow> routine;
    in property <int> row-index;
    callback accept(int);
    callback dismiss(int);

    height: 154px;
    border-radius: 10px;
    border-width: 1px;
    border-color: Theme.border-soft;
    background: Theme.graphite;

    Rectangle {
        x: 0px;
        y: 0px;
        width: 3px;
        height: parent.height;
        border-radius: 2px;
        background: Theme.process;
    }

    Text {
        x: 18px;
        y: 14px;
        width: parent.width - 36px;
        height: 19px;
        text: root.routine.title;
        color: Theme.paper;
        font-size: 12px;
        font-weight: 650;
        overflow: elide;
        vertical-alignment: center;
    }

    Text {
        x: 18px;
        y: 39px;
        width: parent.width - 36px;
        height: 34px;
        text: root.routine.explanation;
        color: Theme.text-tertiary;
        font-size: 10px;
        wrap: word-wrap;
    }

    Rectangle {
        x: 18px;
        y: 82px;
        width: parent.width - 36px;
        height: 24px;
        border-radius: 5px;
        background: Theme.inset;

        Text {
            x: 8px;
            width: parent.width - 16px;
            text: root.routine.action;
            color: Theme.text-secondary;
            font-family: "Cascadia Mono";
            font-size: 9px;
            overflow: elide;
            vertical-alignment: center;
        }
    }

    QuietButton {
        x: 18px;
        y: 114px;
        width: 94px;
        label: "Aprobar";
        primary: true;
        compact: true;
        clicked => { root.accept(root.row-index); }
    }

    QuietButton {
        x: 120px;
        y: 114px;
        width: 90px;
        label: "Ahora no";
        compact: true;
        clicked => { root.dismiss(root.row-index); }
    }
}

export component MainWindow inherits Window {
    in-out property <string> assistant-name: "Tom";
    in-out property <string> status-text: "Local · atento";
    in-out property <int> note-count: 0;
    in-out property <[MemoryRow]> memory-rows: [];
    in-out property <[RoutineRow]> routine-rows: [];
    in-out property <bool> onboarding-visible: true;
    in-out property <bool> settings-visible: false;
    in-out property <string> ai-provider: "disabled";
    in-out property <string> local-endpoint: "";
    in-out property <string> local-model-path: "";
    in-out property <bool> has-api-key: false;
    in-out property <string> orb-state: "idle";
    in-out property <string> active-section: "today";
    in-out property <bool> today-visible: true;
    in-out property <bool> conversation-visible: false;
    in-out property <bool> memory-visible: false;
    in-out property <bool> routines-visible: false;
    in-out property <[ChatRow]> chat-rows: [];
    in-out property <bool> awaiting-reply: false;
    in-out property <string> selected-persona: "tom";
    in-out property <string> selected-profession: "developer";
    in-out property <string> selected-assistance: "balanced";
    in-out property <string> selected-ai-setup: "later";

    // Copy and option lists published by the desktop controller.
    in-out property <string> section-title: "Espacio de enfoque";
    in-out property <string> section-subtitle: "";
    in-out property <string> routines-empty-text: "";
    in-out property <string> endpoint-label: "Endpoint compatible (opcional)";
    in-out property <string> endpoint-placeholder: "";
    in-out property <string> settings-tab: "connection";
    in-out property <string> selected-key-provider: "openai";
    in-out property <string> key-editor-label: "";
    in-out property <string> api-key-summary: "";
    in-out property <[ApiKeyRow]> api-key-rows: [];
    in-out property <bool> intelligence-ready: false;
    in-out property <string> intelligence-hint: "";
    in-out property <int> onboarding-step: 0;
    in-out property <bool> onboarding-can-go-back: false;
    in-out property <string> onboarding-orb-state: "curious";
    in-out property <[OnboardingPage]> onboarding-pages: [];
    in-out property <[string]> welcome-highlights: [];
    in-out property <[ChoiceRow]> persona-choices: [];
    in-out property <[ChoiceRow]> profession-choices: [];
    in-out property <[ChoiceRow]> assistance-choices: [];
    in-out property <[ChoiceRow]> intelligence-choices: [];
    in-out property <[ChoiceRow]> cloud-providers: [];
    in-out property <[ChoiceRow]> local-providers: [];
    in-out property <[PulseRow]> pulse-steps: [];

    callback save-note(string, string);
    callback send-message(string);
    callback clear-conversation();
    // Raised by the desktop shell when a worker thread finishes; not meant for the
    // interface to call. The bool says whether the string is a reply or an explanation.
    callback reply-arrived(bool, string);
    callback persona-selected(string);
    callback onboarding-advance();
    callback onboarding-back();
    callback replay-onboarding();
    callback enter-orb-mode();
    callback navigate-to(string);
    callback accept-routine(int);
    callback dismiss-routine(int);
    callback provider-selected(string);
    callback save-ai-settings(string, string, string);
    callback key-provider-selected(string);
    callback store-api-key(string, string);
    callback forget-api-key(string);

    property <OnboardingPage> onboarding-page: root.onboarding-pages[root.onboarding-step];
    property <string> chat-draft: "";
    property <string> note-title: "";
    property <string> note-body: "";
    property <string> api-key-input: "";

    title: assistant-name + " — asistente personal";
    preferred-width: 1120px;
    preferred-height: 680px;
    min-width: 1000px;
    min-height: 640px;
    background: Theme.canvas;
    default-font-family: "Segoe UI Variable Text";
    default-font-size: 12px;

    HorizontalLayout {
        spacing: 0px;

        Rectangle {
            width: 84px;
            background: Theme.canvas;

            OrbVisual {
                x: 19px;
                y: 12px;
                width: 46px;
                height: 46px;
                state: root.orb-state;
            }

            VerticalLayout {
                x: 8px;
                y: 86px;
                width: parent.width - 16px;
                spacing: 8px;

                NavItem {
                    glyph: "⌁"; label: "HOY";
                    selected: root.active-section == "today";
                    activated => { root.navigate-to("today"); }
                }
                NavItem {
                    glyph: "◈"; label: "HABLAR";
                    selected: root.active-section == "conversation";
                    activated => { root.navigate-to("conversation"); }
                }
                NavItem {
                    glyph: "◇"; label: "MEMORIA";
                    selected: root.active-section == "memory";
                    activated => { root.navigate-to("memory"); }
                }
                NavItem {
                    glyph: "↻"; label: "RUTINAS";
                    selected: root.active-section == "routines";
                    activated => { root.navigate-to("routines"); }
                }
            }

            Rectangle {
                x: 24px;
                y: parent.height - 54px;
                width: 36px;
                height: 36px;
                border-radius: 18px;
                border-width: 1px;
                border-color: Theme.border;
                background: Theme.graphite;

                Text {
                    text: "⚙";
                    color: Theme.text-tertiary;
                    font-family: "Segoe UI Symbol";
                    font-size: 14px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                TouchArea {
                    accessible-role: button;
                    accessible-label: "Abrir configuración";
                    clicked => { root.settings-visible = true; }
                }
            }
        }

        Rectangle {
            width: 1px;
            background: Theme.border-soft;
        }

        Rectangle {
            horizontal-stretch: 1;
            background: Theme.ink;

            Rectangle {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: 66px;
                background: Theme.ink;

                Text {
                    x: 28px;
                    y: 14px;
                    width: 300px;
                    height: 20px;
                    text: root.section-title;
                    color: Theme.paper;
                    font-family: "Segoe UI Variable Display";
                    font-size: 15px;
                    font-weight: 650;
                    vertical-alignment: center;
                }

                Text {
                    x: 28px;
                    y: 35px;
                    width: 420px;
                    height: 16px;
                    text: root.section-subtitle;
                    color: Theme.text-tertiary;
                    font-size: 10px;
                    vertical-alignment: center;
                }

                Rectangle {
                    x: parent.width - 196px;
                    y: 20px;
                    width: 168px;
                    height: 28px;
                    border-radius: 14px;
                    border-width: 1px;
                    border-color: Theme.border-soft;
                    background: Theme.graphite;

                    Rectangle {
                        x: 10px;
                        y: 10px;
                        width: 7px;
                        height: 7px;
                        border-radius: 4px;
                        background: Theme.process;
                    }

                    Text {
                        x: 26px;
                        width: parent.width - 34px;
                        text: root.status-text;
                        color: Theme.text-secondary;
                        font-size: 10px;
                        font-weight: 500;
                        overflow: elide;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    x: parent.width - 232px;
                    y: 20px;
                    width: 28px;
                    height: 28px;
                    border-radius: 14px;
                    border-width: 1px;
                    border-color: Theme.border-soft;
                    background: orb-mode-touch.has-hover ? Theme.lavender-soft : Theme.graphite;

                    Text {
                        text: "◉";
                        color: Theme.lavender;
                        font-size: 12px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    orb-mode-touch := TouchArea {
                        accessible-role: button;
                        accessible-label: "Reducir a orbe";
                        clicked => { root.enter-orb-mode(); }
                    }
                }

                Rectangle { y: parent.height - 1px; width: parent.width; height: 1px; background: Theme.border-soft; }
            }

            Rectangle {
                x: 28px;
                y: 90px;
                width: parent.width - 56px;
                height: parent.height - 116px;
                background: Theme.ink;
                clip: true;

                if root.today-visible : HorizontalLayout {
                    width: parent.width;
                    height: parent.height;
                    spacing: 24px;

                Rectangle {
                    horizontal-stretch: 7;
                    background: transparent;

                    VerticalLayout {
                        spacing: 16px;

                        Rectangle {
                            height: 246px;
                            border-radius: 12px;
                            border-width: 1px;
                            border-color: Theme.border-soft;
                            background: Theme.graphite;

                            SectionLabel {
                                x: 20px;
                                y: 16px;
                                width: 220px;
                                height: 16px;
                                label: "Nueva memoria";
                            }

                            Text {
                                x: 20px;
                                y: 38px;
                                width: parent.width - 40px;
                                height: 22px;
                                text: "¿Qué no quieres volver a reconstruir mañana?";
                                color: Theme.paper;
                                font-family: "Segoe UI Variable Display";
                                font-size: 16px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }

                            QuietInput {
                                x: 20px;
                                y: 72px;
                                width: parent.width - 40px;
                                height: 38px;
                                value <=> root.note-title;
                                placeholder: "Título breve";
                            }

                            QuietInput {
                                x: 20px;
                                y: 120px;
                                width: parent.width - 40px;
                                height: 72px;
                                value <=> root.note-body;
                                placeholder: "Decisión, contexto o siguiente paso…";
                                multiline: true;
                            }

                            Text {
                                x: 20px;
                                y: 205px;
                                width: parent.width - 160px;
                                height: 24px;
                                text: "Sólo se guarda lo que tú decides.";
                                color: Theme.text-muted;
                                font-size: 9px;
                                vertical-alignment: center;
                            }

                            QuietButton {
                                x: parent.width - 132px;
                                y: 199px;
                                width: 112px;
                                label: "Guardar memoria";
                                primary: true;
                                compact: true;
                                clicked => {
                                    if (root.note-title != "" || root.note-body != "") {
                                        root.save-note(root.note-title, root.note-body);
                                        root.note-title = "";
                                        root.note-body = "";
                                    }
                                }
                            }
                        }

                        Rectangle {
                            vertical-stretch: 1;
                            background: transparent;

                            SectionLabel {
                                x: 0px;
                                y: 0px;
                                width: 200px;
                                height: 16px;
                                label: "Memoria reciente";
                            }

                            Text {
                                x: parent.width - 130px;
                                y: 0px;
                                width: 130px;
                                height: 16px;
                                text: root.note-count + (root.note-count == 1 ? " memoria" : " memorias");
                                color: Theme.text-muted;
                                font-size: 9px;
                                horizontal-alignment: right;
                                vertical-alignment: center;
                            }

                            Rectangle {
                                y: 27px;
                                width: parent.width;
                                height: parent.height - 27px;
                                border-radius: 10px;
                                border-width: 1px;
                                border-color: Theme.border-soft;
                                background: Theme.canvas;

                                if root.memory-rows.length == 0 : Rectangle {
                                    Text {
                                        x: 24px;
                                        width: parent.width - 48px;
                                        text: "Tu memoria está lista para la primera decisión que valga la pena conservar.";
                                        color: Theme.text-muted;
                                        font-size: 11px;
                                        wrap: word-wrap;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }

                                if root.memory-rows.length > 0 : Flickable {
                                    x: 8px;
                                    y: 8px;
                                    width: parent.width - 16px;
                                    height: parent.height - 16px;
                                    viewport-width: self.width;
                                    viewport-height: memory-list.preferred-height;

                                    memory-list := VerticalLayout {
                                        width: parent.width;
                                        spacing: 2px;

                                        for memory in root.memory-rows : MemoryItem {
                                            memory: memory;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                Rectangle {
                    width: 1px;
                    background: Theme.border-soft;
                }

                Rectangle {
                    horizontal-stretch: 5;
                    background: transparent;

                    VerticalLayout {
                        spacing: 18px;

                        Rectangle {
                            height: 320px;
                            background: transparent;

                            SectionLabel {
                                x: 0px;
                                y: 0px;
                                width: 220px;
                                height: 16px;
                                label: "Activity pulse";
                            }

                            Text {
                                x: 0px;
                                y: 23px;
                                width: parent.width;
                                height: 18px;
                                text: "El razonamiento queda a la vista";
                                color: Theme.text-secondary;
                                font-size: 11px;
                                vertical-alignment: center;
                            }

                            Rectangle {
                                y: 56px;
                                width: parent.width;
                                height: 264px;
                                border-radius: 10px;
                                border-width: 1px;
                                border-color: Theme.border-soft;
                                background: Theme.canvas;

                                VerticalLayout {
                                    x: 18px;
                                    y: 12px;
                                    width: parent.width - 36px;
                                    height: parent.height - 24px;
                                    spacing: 0px;

                                    for step[index] in root.pulse-steps : PulseStep {
                                        step: step;
                                        last: index == root.pulse-steps.length - 1;
                                    }
                                }
                            }
                        }

                        Rectangle {
                            vertical-stretch: 1;
                            background: transparent;

                            SectionLabel {
                                x: 0px;
                                y: 0px;
                                width: 220px;
                                height: 16px;
                                label: "Rutinas sugeridas";
                            }

                            if root.routine-rows.length == 0 : Rectangle {
                                y: 28px;
                                width: parent.width;
                                height: parent.height - 28px;
                                border-radius: 10px;
                                border-width: 1px;
                                border-color: Theme.border-soft;
                                background: Theme.canvas;

                                Text {
                                    x: 24px;
                                    width: parent.width - 48px;
                                    text: root.routines-empty-text;
                                    color: Theme.text-muted;
                                    font-size: 10px;
                                    wrap: word-wrap;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }

                            if root.routine-rows.length > 0 : Flickable {
                                y: 28px;
                                width: parent.width;
                                height: parent.height - 28px;
                                viewport-width: self.width;
                                viewport-height: routine-list.preferred-height;

                                routine-list := VerticalLayout {
                                    width: parent.width;
                                    spacing: 10px;

                                    for routine[index] in root.routine-rows : RoutineItem {
                                        routine: routine;
                                        row-index: index;
                                        accept(row-index) => { root.accept-routine(row-index); }
                                        dismiss(row-index) => { root.dismiss-routine(row-index); }
                                    }
                                }
                            }
                        }
                    }
                }
            }

                if root.conversation-visible : Rectangle {
                    width: parent.width;
                    height: parent.height;
                    background: Theme.ink;
                    clip: true;

                    // The transcript takes all the room it can; the composer keeps a fixed
                    // strip at the bottom so it never scrolls out of reach.
                    Rectangle {
                        y: 0px;
                        width: parent.width;
                        height: parent.height - 132px;
                        border-radius: 12px;
                        border-width: 1px;
                        border-color: Theme.border-soft;
                        background: Theme.canvas;

                        if root.chat-rows.length == 0 : Text {
                            x: 60px;
                            width: parent.width - 120px;
                            text: "Preguntale algo a " + root.assistant-name + ". La conversacion vive en esta sesion y no se guarda en tu memoria local.";
                            color: Theme.text-muted;
                            font-size: 11px;
                            wrap: word-wrap;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        if root.chat-rows.length > 0 : Flickable {
                            x: 16px;
                            y: 12px;
                            width: parent.width - 32px;
                            height: parent.height - 24px;
                            viewport-width: self.width;
                            viewport-height: transcript.preferred-height;
                            // Keep the newest turn in view as the conversation grows.
                            viewport-y: min(0px, self.height - transcript.preferred-height);

                            transcript := VerticalLayout {
                                width: parent.width;
                                spacing: 4px;

                                for turn in root.chat-rows : ChatBubble {
                                    turn: turn;
                                }
                            }
                        }
                    }

                    Rectangle {
                        y: parent.height - 120px;
                        width: parent.width;
                        height: 18px;
                        background: transparent;

                        Text {
                            width: parent.width;
                            height: parent.height;
                            text: root.awaiting-reply ? root.assistant-name + " esta pensando..." : "";
                            color: Theme.lavender;
                            font-size: 10px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }

                        if root.chat-rows.length > 0 : QuietButton {
                            x: parent.width - 150px;
                            y: -7px;
                            width: 150px;
                            label: "Borrar conversacion";
                            compact: true;
                            clicked => { root.clear-conversation(); }
                        }
                    }

                    QuietInput {
                        y: parent.height - 96px;
                        width: parent.width - 170px;
                        height: 96px;
                        value <=> root.chat-draft;
                        placeholder: "Escribe lo que necesitas...";
                        multiline: true;
                    }

                    QuietButton {
                        x: parent.width - 158px;
                        y: parent.height - 96px;
                        width: 158px;
                        label: root.awaiting-reply ? "Enviando..." : "Enviar";
                        primary: true;
                        clicked => {
                            if (!root.awaiting-reply && root.chat-draft != "") {
                                root.send-message(root.chat-draft);
                                root.chat-draft = "";
                            }
                        }
                    }
                }

                if root.memory-visible : Rectangle {
                    width: parent.width;
                    height: parent.height;
                    background: Theme.ink;
                    clip: true;

                Rectangle {
                    width: 340px;
                    height: parent.height;
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: Theme.border-soft;
                    background: Theme.graphite;

                    SectionLabel { x: 20px; y: 18px; width: 220px; height: 16px; label: "Añadir al archivo"; }

                    Text {
                        x: 20px; y: 46px; width: parent.width - 40px; height: 52px;
                        text: "Guarda una decisión con el contexto suficiente para recuperarla después.";
                        color: Theme.paper; font-size: 15px; font-weight: 600; wrap: word-wrap;
                    }

                    Text {
                        x: 20px; y: 118px; width: parent.width - 40px; height: 16px;
                        text: "Título"; color: Theme.text-secondary; font-size: 10px; font-weight: 600;
                    }
                    QuietInput {
                        x: 20px; y: 140px; width: parent.width - 40px; height: 40px;
                        value <=> root.note-title; placeholder: "Qué quieres recordar";
                    }

                    Text {
                        x: 20px; y: 198px; width: parent.width - 40px; height: 16px;
                        text: "Contexto"; color: Theme.text-secondary; font-size: 10px; font-weight: 600;
                    }
                    QuietInput {
                        x: 20px; y: 220px; width: parent.width - 40px; height: 154px;
                        value <=> root.note-body; placeholder: "Decisión, motivo y siguiente paso…"; multiline: true;
                    }

                    Text {
                        x: 20px; y: parent.height - 82px; width: parent.width - 40px; height: 20px;
                        text: "Sólo tú decides qué entra en la memoria.";
                        color: Theme.text-muted; font-size: 9px;
                    }
                    QuietButton {
                        x: 20px; y: parent.height - 54px; width: parent.width - 40px;
                        label: "Guardar memoria"; primary: true;
                        clicked => {
                            if (root.note-title != "" || root.note-body != "") {
                                root.save-note(root.note-title, root.note-body);
                                root.note-title = "";
                                root.note-body = "";
                            }
                        }
                    }
                }

                Rectangle {
                    x: 364px;
                    width: parent.width - 364px;
                    height: parent.height;
                    background: transparent;

                    SectionLabel { x: 0px; y: 0px; width: 220px; height: 16px; label: "Todo lo recordado"; }
                    Text {
                        x: parent.width - 150px; y: 0px; width: 150px; height: 16px;
                        text: root.note-count + (root.note-count == 1 ? " memoria" : " memorias");
                        color: Theme.text-muted; font-size: 9px; horizontal-alignment: right;
                    }

                    Rectangle {
                        y: 28px; width: parent.width; height: parent.height - 28px;
                        border-radius: 12px; border-width: 1px; border-color: Theme.border-soft;
                        background: Theme.canvas;

                        if root.memory-rows.length == 0 : Text {
                            x: 48px; width: parent.width - 96px;
                            text: "Aún no hay memorias. Empieza por una decisión que no quieras reconstruir mañana.";
                            color: Theme.text-muted; font-size: 11px; wrap: word-wrap;
                            horizontal-alignment: center; vertical-alignment: center;
                        }

                        if root.memory-rows.length > 0 : Flickable {
                            x: 10px; y: 10px; width: parent.width - 20px; height: parent.height - 20px;
                            viewport-width: self.width; viewport-height: memory-archive.preferred-height;

                            memory-archive := VerticalLayout {
                                width: parent.width; spacing: 4px;
                                for memory in root.memory-rows : MemoryItem { memory: memory; }
                            }
                        }
                    }
                }
            }

                if root.routines-visible : Rectangle {
                    width: parent.width;
                    height: parent.height;
                    background: Theme.ink;
                    clip: true;

                Rectangle {
                    width: 390px;
                    height: parent.height;
                    background: transparent;

                    SectionLabel { x: 0px; y: 0px; width: 220px; height: 16px; label: "Activity pulse"; }
                    Text {
                        x: 0px; y: 28px; width: parent.width; height: 38px;
                        text: "La señal completa detrás de cada propuesta.";
                        color: Theme.paper; font-size: 15px; font-weight: 600; wrap: word-wrap;
                    }

                    Rectangle {
                        y: 82px; width: parent.width; height: 320px;
                        border-radius: 12px; border-width: 1px; border-color: Theme.border-soft;
                        background: Theme.canvas;

                        VerticalLayout {
                            x: 20px; y: 16px; width: parent.width - 40px; height: parent.height - 32px;
                            for step[index] in root.pulse-steps : PulseStep {
                                step: step;
                                last: index == root.pulse-steps.length - 1;
                            }
                        }
                    }

                    Text {
                        x: 0px; y: 426px; width: parent.width; height: 48px;
                        text: "Tom nunca convierte una observación en automatización sin enseñarte primero el porqué.";
                        color: Theme.text-muted; font-size: 10px; wrap: word-wrap;
                    }
                }

                Rectangle { x: 414px; width: 1px; height: parent.height; background: Theme.border-soft; }

                Rectangle {
                    x: 439px;
                    width: parent.width - 439px;
                    height: parent.height;
                    background: transparent;

                    SectionLabel { x: 0px; y: 0px; width: 240px; height: 16px; label: "Esperando tu decisión"; }
                    Text {
                        x: 0px; y: 28px; width: parent.width; height: 38px;
                        text: "Cada rutina explica qué detectó y qué hará antes de activarse.";
                        color: Theme.text-secondary; font-size: 11px; wrap: word-wrap;
                    }

                    if root.routine-rows.length == 0 : Rectangle {
                        y: 82px; width: parent.width; height: parent.height - 82px;
                        border-radius: 12px; border-width: 1px; border-color: Theme.border-soft;
                        background: Theme.canvas;

                        Text {
                            x: 36px; width: parent.width - 72px;
                            text: root.routines-empty-text;
                            color: Theme.text-muted; font-size: 11px; wrap: word-wrap;
                            horizontal-alignment: center; vertical-alignment: center;
                        }
                    }

                    if root.routine-rows.length > 0 : Flickable {
                        y: 82px; width: parent.width; height: parent.height - 82px;
                        viewport-width: self.width; viewport-height: routine-review.preferred-height;

                        routine-review := VerticalLayout {
                            width: parent.width; spacing: 12px;
                            for routine[index] in root.routine-rows : RoutineItem {
                                routine: routine; row-index: index;
                                accept(row-index) => { root.accept-routine(row-index); }
                                dismiss(row-index) => { root.dismiss-routine(row-index); }
                            }
                        }
                    }
                }
                }
            }
        }
    }

    if root.onboarding-visible : Rectangle {
        z: 110;
        background: Theme.canvas;

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 920px;
            height: 590px;
            border-radius: 16px;
            border-width: 1px;
            border-color: Theme.border-soft;
            background: Theme.ink;

            Rectangle {
                width: 286px;
                height: parent.height;
                border-radius: 16px;
                background: Theme.canvas;

                OrbVisual {
                    x: 54px;
                    y: 42px;
                    width: 178px;
                    height: 178px;
                    state: root.onboarding-orb-state;
                }

                Text {
                    x: 32px;
                    y: 226px;
                    width: parent.width - 64px;
                    height: 24px;
                    text: root.assistant-name;
                    color: Theme.paper;
                    font-family: "Segoe UI Variable Display";
                    font-size: 18px;
                    font-weight: 650;
                    horizontal-alignment: center;
                }

                Text {
                    x: 32px;
                    y: 254px;
                    width: parent.width - 64px;
                    height: 38px;
                    text: root.onboarding-page.caption;
                    color: Theme.text-tertiary;
                    font-size: 10px;
                    wrap: word-wrap;
                    horizontal-alignment: center;
                }

                for page[index] in root.onboarding-pages : Rectangle {
                    x: 34px;
                    y: 330px + index * 42px;
                    width: parent.width - 68px;
                    height: 32px;
                    border-radius: 7px;
                    background: root.onboarding-step == index ? Theme.graphite : transparent;

                    Rectangle {
                        x: 8px;
                        y: 11px;
                        width: 10px;
                        height: 10px;
                        border-radius: 5px;
                        background: root.onboarding-step > index ? Theme.process
                            : root.onboarding-step == index ? Theme.lavender : Theme.border;
                    }

                    Text {
                        x: 28px;
                        width: parent.width - 36px;
                        text: page.rail-label;
                        color: root.onboarding-step == index ? Theme.paper : Theme.text-muted;
                        font-size: 10px;
                        font-weight: root.onboarding-step == index ? 650 : 500;
                        vertical-alignment: center;
                    }
                }

                Text {
                    x: 28px;
                    y: parent.height - 34px;
                    width: parent.width - 56px;
                    height: 14px;
                    text: "Local primero · siempre reversible";
                    color: Theme.text-muted;
                    font-size: 8px;
                    horizontal-alignment: center;
                }
            }

            Rectangle {
                x: 286px;
                width: 1px;
                height: parent.height;
                background: Theme.border-soft;
            }

            Rectangle {
                x: 287px;
                width: parent.width - 287px;
                height: parent.height;
                background: transparent;

                Text {
                    x: 42px;
                    y: 38px;
                    width: parent.width - 84px;
                    height: 34px;
                    text: root.onboarding-page.headline;
                    color: Theme.paper;
                    font-family: "Segoe UI Variable Display";
                    font-size: 22px;
                    font-weight: 650;
                }

                Text {
                    x: 42px;
                    y: 80px;
                    width: parent.width - 84px;
                    height: 42px;
                    text: root.onboarding-page.body;
                    color: Theme.text-tertiary;
                    font-size: 11px;
                    wrap: word-wrap;
                }

                if root.onboarding-step == 0 : Rectangle {
                    x: 42px;
                    y: 150px;
                    width: parent.width - 84px;
                    height: 250px;
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: Theme.border-soft;
                    background: Theme.canvas;

                    Text {
                        x: 24px; y: 24px; width: parent.width - 48px; height: 26px;
                        text: "Lo importante desde el primer minuto";
                        color: Theme.paper; font-size: 14px; font-weight: 650;
                    }
                    for highlight[index] in root.welcome-highlights : Text {
                        x: 24px; y: 70px + index * 42px; width: parent.width - 48px; height: 28px;
                        text: highlight;
                        color: Theme.text-secondary; font-size: 11px;
                    }
                }

                if root.onboarding-step == 1 : Rectangle {
                    x: 42px; y: 142px; width: parent.width - 84px; height: 250px; background: transparent;

                    for choice[index] in root.persona-choices : OnboardingChoice {
                        y: index * 120px; width: parent.width; height: 104px;
                        choice: choice;
                        selected: root.selected-persona == choice.id;
                        // The controller owns the persona, so the whole window changes voice at once.
                        chosen(id) => { root.persona-selected(id); }
                    }
                }

                if root.onboarding-step == 2 : Rectangle {
                    x: 42px; y: 138px; width: parent.width - 84px; height: 310px; background: transparent;

                    // Two columns, with a lone trailing option widened to close the row.
                    for choice[index] in root.profession-choices : OnboardingChoice {
                        x: mod(index, 2) * 260px;
                        y: floor(index / 2) * 92px;
                        width: index == root.profession-choices.length - 1 && mod(index, 2) == 0
                            ? 504px : 244px;
                        choice: choice;
                        selected: root.selected-profession == choice.id;
                        chosen(id) => { root.selected-profession = id; }
                    }
                }

                if root.onboarding-step == 3 : Rectangle {
                    x: 42px; y: 142px; width: parent.width - 84px; height: 310px; background: transparent;

                    for choice[index] in root.assistance-choices : OnboardingChoice {
                        y: index * 92px; width: parent.width;
                        choice: choice;
                        selected: root.selected-assistance == choice.id;
                        chosen(id) => { root.selected-assistance = id; }
                    }
                }

                if root.onboarding-step == 4 : Rectangle {
                    x: 42px; y: 142px; width: parent.width - 84px; height: 310px; background: transparent;

                    for choice[index] in root.intelligence-choices : OnboardingChoice {
                        y: index * 92px; width: parent.width;
                        choice: choice;
                        selected: root.selected-ai-setup == choice.id;
                        chosen(id) => { root.selected-ai-setup = id; }
                    }
                }

                if root.onboarding-can-go-back : QuietButton {
                    x: 42px;
                    y: parent.height - 66px;
                    width: 104px;
                    label: "Atrás";
                    compact: true;
                    clicked => { root.onboarding-back(); }
                }

                QuietButton {
                    x: parent.width - 184px;
                    y: parent.height - 72px;
                    width: 142px;
                    label: root.onboarding-page.primary-label;
                    primary: true;
                    clicked => { root.onboarding-advance(); }
                }

                Text {
                    x: 42px;
                    y: parent.height - 28px;
                    width: parent.width - 84px;
                    height: 12px;
                    text: "Built with Slint";
                    color: Theme.text-muted;
                    font-size: 8px;
                    horizontal-alignment: right;
                }
            }
        }
    }

    if root.settings-visible : Rectangle {
        z: 120;
        background: #0d0f14ed;

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 820px;
            height: 606px;
            border-radius: 16px;
            border-width: 1px;
            border-color: Theme.border;
            background: Theme.graphite;

            Text {
                x: 28px;
                y: 24px;
                width: 420px;
                height: 28px;
                text: "Inteligencia artificial";
                color: Theme.paper;
                font-family: "Segoe UI Variable Display";
                font-size: 20px;
                font-weight: 650;
            }

            Text {
                x: 28px;
                y: 56px;
                width: 660px;
                height: 32px;
                text: "Conecta un proveedor de nube o un modelo que ya se ejecute en tu PC.";
                color: Theme.text-tertiary;
                font-size: 11px;
                wrap: word-wrap;
            }

            // One way in is enough; none at all is the only state Tom cannot work in, and it
            // is said plainly here rather than discovered when a request fails.
            if !root.intelligence-ready : Rectangle {
                x: 28px; y: 82px; width: parent.width - 56px; height: 34px;
                border-radius: 8px;
                border-width: 1px;
                border-color: Theme.warning;
                background: Theme.inset;

                Text {
                    x: 14px; width: parent.width - 28px; height: parent.height;
                    text: root.intelligence-hint;
                    color: Theme.warning;
                    font-size: 10px;
                    font-weight: 600;
                    overflow: elide;
                    vertical-alignment: center;
                }
            }

            // Two tabs: where Tom connects, and which credentials are stored. Keys are only
            // ever touched from the second one, and only by an explicit button.
            HorizontalLayout {
                x: 28px; y: 126px; width: 320px; height: 30px; spacing: 8px;

                for pane in [
                    { id: "connection", label: "Conexión" },
                    { id: "keys", label: "Claves guardadas" },
                ] : Rectangle {
                    border-radius: 7px;
                    border-width: 1px;
                    border-color: root.settings-tab == pane.id ? Theme.lavender : Theme.border-soft;
                    background: root.settings-tab == pane.id ? Theme.lavender-soft : Theme.canvas;

                    Text {
                        text: pane.label;
                        color: root.settings-tab == pane.id ? Theme.paper : Theme.text-tertiary;
                        font-size: 11px;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    TouchArea {
                        accessible-role: tab;
                        accessible-label: pane.label;
                        clicked => { root.settings-tab = pane.id; }
                    }
                }
            }

            if root.settings-tab == "connection" : Rectangle {
                x: 0px; y: 170px; width: parent.width; height: 370px; background: transparent;

                SectionLabel { x: 28px; y: 0px; width: 180px; height: 16px; label: "Modelos en la nube"; }

                HorizontalLayout {
                    x: 28px; y: 24px; width: parent.width - 56px; height: 54px; spacing: 10px;

                    for provider in root.cloud-providers : ProviderOption {
                        provider: provider;
                        selected: root.ai-provider == provider.id;
                        chosen(id) => { root.provider-selected(id); }
                    }
                }

                SectionLabel { x: 28px; y: 98px; width: 180px; height: 16px; label: "Modelos locales"; }

                HorizontalLayout {
                    x: 28px; y: 122px; width: parent.width - 56px; height: 54px; spacing: 10px;

                    for provider in root.local-providers : ProviderOption {
                        provider: provider;
                        selected: root.ai-provider == provider.id;
                        chosen(id) => { root.provider-selected(id); }
                    }
                }

                SectionLabel { x: 28px; y: 196px; width: 240px; height: 16px; label: "Conexión"; }

                Text {
                    x: 28px; y: 222px; width: 360px; height: 16px;
                    text: root.endpoint-label;
                    color: Theme.text-secondary; font-size: 10px; font-weight: 600;
                }
                QuietInput {
                    x: 28px; y: 242px; width: 366px; height: 38px;
                    value <=> root.local-endpoint;
                    placeholder: root.endpoint-placeholder;
                }

                Text {
                    x: 410px; y: 222px; width: 382px; height: 16px;
                    text: "Modelo o ruta local";
                    color: Theme.text-secondary; font-size: 10px; font-weight: 600;
                }
                QuietInput {
                    x: 410px; y: 242px; width: 382px; height: 38px;
                    value <=> root.local-model-path;
                    placeholder: "llama3.2, qwen… o C:\\modelos\\modelo.gguf";
                }

                // Read-only here on purpose: the credential itself is managed in the other tab.
                Rectangle {
                    x: 28px; y: 300px; width: parent.width - 56px; height: 46px;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: Theme.border-soft;
                    background: Theme.canvas;

                    Rectangle {
                        x: 16px; y: 19px; width: 8px; height: 8px; border-radius: 4px;
                        background: root.has-api-key ? Theme.process : Theme.border;
                    }

                    Text {
                        x: 34px; width: 470px; height: parent.height;
                        text: root.api-key-summary;
                        color: root.has-api-key ? Theme.text-secondary : Theme.text-muted;
                        font-size: 10px;
                        overflow: elide;
                        vertical-alignment: center;
                    }

                    QuietButton {
                        x: parent.width - 168px; y: 7px; width: 152px;
                        label: "Gestionar claves"; compact: true;
                        clicked => { root.settings-tab = "keys"; }
                    }
                }
            }

            if root.settings-tab == "keys" : Rectangle {
                x: 0px; y: 170px; width: parent.width; height: 370px; background: transparent;

                Text {
                    x: 28px; y: 0px; width: parent.width - 56px; height: 30px;
                    text: "Cada proveedor guarda su propia clave. Añadir una no toca las demás, y nada se borra salvo que lo pidas aquí.";
                    color: Theme.text-tertiary; font-size: 10px; wrap: word-wrap;
                }

                Flickable {
                    x: 28px; y: 36px; width: parent.width - 56px; height: 232px;
                    viewport-width: self.width;
                    viewport-height: key-list.preferred-height;

                    key-list := VerticalLayout {
                        width: parent.width;
                        spacing: 6px;

                        for entry in root.api-key-rows : ApiKeyItem {
                            entry: entry;
                            selected: root.selected-key-provider == entry.provider-id;
                            chosen(id) => {
                                root.key-provider-selected(id);
                                root.api-key-input = "";
                            }
                            forget(id) => { root.forget-api-key(id); }
                        }
                    }
                }

                Text {
                    x: 28px; y: 280px; width: 500px; height: 16px;
                    text: root.key-editor-label;
                    color: Theme.text-secondary; font-size: 10px; font-weight: 600;
                }

                QuietInput {
                    x: 28px; y: 300px; width: 506px; height: 38px;
                    value <=> root.api-key-input;
                    placeholder: "Pega la clave; no se volverá a mostrar";
                    secret: true;
                }

                QuietButton {
                    x: 546px; y: 303px; width: 158px;
                    label: "Guardar clave"; primary: true; compact: true;
                    clicked => {
                        root.store-api-key(root.selected-key-provider, root.api-key-input);
                        root.api-key-input = "";
                    }
                }
            }

            Text {
                x: 28px; y: 518px; width: 540px; height: 32px;
                text: "Las claves se guardan en Windows Credential Manager. Nunca se escriben en SQLite, Git ni archivos del proyecto.";
                color: Theme.text-muted; font-size: 9px; wrap: word-wrap;
            }

            QuietButton {
                x: 28px; y: 552px; width: 126px;
                label: "Desactivar IA"; compact: true;
                clicked => { root.provider-selected("disabled"); }
            }

            QuietButton {
                x: 164px; y: 552px; width: 154px;
                label: "Repetir bienvenida"; compact: true;
                clicked => {
                    root.settings-visible = false;
                    root.replay-onboarding();
                }
            }

            QuietButton {
                x: parent.width - 280px; y: 552px; width: 102px;
                label: "Cerrar"; compact: true;
                clicked => { root.settings-visible = false; }
            }

            QuietButton {
                x: parent.width - 168px; y: 546px; width: 140px;
                label: "Guardar conexión"; primary: true;
                clicked => {
                    root.save-ai-settings(root.ai-provider, root.local-endpoint, root.local-model-path);
                    root.settings-visible = false;
                }
            }
        }
    }
}

export component OrbWindow inherits Window {
    in-out property <string> assistant-name: "Tom";
    in-out property <string> orb-state: "idle";
    in-out property <int> orb-size: 176;
    // Bounds come from the controller so the window and the resize logic cannot disagree.
    in-out property <int> orb-min-size: 96;
    in-out property <int> orb-max-size: 288;
    property <bool> controls-visible: orb-touch.has-hover || shrink-touch.has-hover || grow-touch.has-hover;
    callback restore-dashboard();
    callback drag-orb(float, float);
    callback resize-orb(string);

    title: assistant-name + " — modo orbe";
    preferred-width: root.orb-size * 1px;
    preferred-height: root.orb-size * 1px;
    min-width: root.orb-min-size * 1px;
    min-height: root.orb-min-size * 1px;
    max-width: root.orb-max-size * 1px;
    max-height: root.orb-max-size * 1px;
    no-frame: true;
    always-on-top: true;
    background: transparent;

    Rectangle {
        x: 4px;
        y: 4px;
        width: parent.width - 8px;
        height: parent.height - 8px;
        border-radius: self.width / 2;
        background: root.controls-visible ? #171a227d : transparent;

        OrbVisual {
            x: 4px;
            y: 4px;
            width: parent.width - 8px;
            height: parent.height - 8px;
            state: root.orb-state;
        }

        orb-touch := TouchArea {
            property <bool> dragged: false;
            accessible-role: button;
            accessible-label: "Arrastrar o restaurar " + root.assistant-name;
            mouse-cursor: move;

            pointer-event(event) => {
                if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                    self.dragged = false;
                }
            }
            moved => {
                if (self.pressed && (abs(self.mouse-x - self.pressed-x) > 1px || abs(self.mouse-y - self.pressed-y) > 1px)) {
                    self.dragged = true;
                    root.drag-orb(
                        (self.mouse-x - self.pressed-x) / 1px,
                        (self.mouse-y - self.pressed-y) / 1px
                    );
                }
            }
            clicked => {
                if (!self.dragged) {
                    root.restore-dashboard();
                }
            }
            scroll-event(event) => {
                if (event.delta-y != 0px) {
                    root.resize-orb(event.delta-y > 0px ? "larger" : "smaller");
                    return accept;
                }
                reject
            }
        }

        Rectangle {
            x: 12px;
            y: parent.height - 36px;
            width: 24px;
            height: 24px;
            border-radius: 12px;
            border-width: root.controls-visible ? 1px : 0px;
            border-color: Theme.border;
            background: root.controls-visible ? #0d0f14e6 : transparent;

            Text {
                text: "−";
                color: root.controls-visible ? (root.orb-size > root.orb-min-size ? Theme.paper : Theme.text-muted) : transparent;
                font-size: 14px;
                font-weight: 650;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            shrink-touch := TouchArea {
                enabled: root.orb-size > root.orb-min-size;
                accessible-role: button;
                accessible-label: "Reducir tamaño del orbe";
                mouse-cursor: pointer;
                clicked => { root.resize-orb("smaller"); }
            }
        }

        Rectangle {
            x: parent.width - 36px;
            y: parent.height - 36px;
            width: 24px;
            height: 24px;
            border-radius: 12px;
            border-width: root.controls-visible ? 1px : 0px;
            border-color: Theme.border;
            background: root.controls-visible ? #0d0f14e6 : transparent;

            Text {
                text: "+";
                color: root.controls-visible ? (root.orb-size < root.orb-max-size ? Theme.paper : Theme.text-muted) : transparent;
                font-size: 14px;
                font-weight: 650;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            grow-touch := TouchArea {
                enabled: root.orb-size < root.orb-max-size;
                accessible-role: button;
                accessible-label: "Aumentar tamaño del orbe";
                mouse-cursor: pointer;
                clicked => { root.resize-orb("larger"); }
            }
        }
    }
}
