                    text: root.onboarding-step == 0 ? "Hola. Soy Tom."
                        : root.onboarding-step == 1 ? "¿Cómo quieres que hable contigo?"
                        : root.onboarding-step == 2 ? "¿En qué mundo trabajaremos juntos?"
                        : root.onboarding-step == 3 ? "¿Cuánta iniciativa quieres de mí?"
                        : "¿Qué inteligencia quieres conectar?";
