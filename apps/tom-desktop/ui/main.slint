                    font-size: 18px;
                    font-weight: 650;
                    horizontal-alignment: center;
                }

                Text {
                    x: 32px;
                    y: 254px;
                    width: parent.width - 64px;
                    height: 38px;
                    text: root.onboarding-step == 0 ? "Una presencia tranquila para tu escritorio."
                        : root.onboarding-step == 1 ? "Mi voz se adapta; tus controles no cambian."
                        : root.onboarding-step == 2 ? "Aprenderé el contexto de tu trabajo."
                        : root.onboarding-step == 3 ? "Tú decides cuánto puedo anticiparme."
                        : "Puedes conectar una IA ahora o después.";
                    color: Theme.text-tertiary;
                    font-size: 10px;
                    wrap: word-wrap;
                    horizontal-alignment: center;
                }

                for step[index] in ["Hola", "Personalidad", "Tu mundo", "Iniciativa", "Inteligencia"] : Rectangle {
                    x: 34px;
                    y: 330px + index * 42px;
                    width: parent.width - 68px;
                    height: 32px;
