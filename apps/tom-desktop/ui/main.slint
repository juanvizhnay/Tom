                height: 178px;
                border-radius: 12px;
                border-width: root.selected-persona == "professional" ? 1.5px : 1px;
                border-color: root.selected-persona == "professional" ? Theme.lavender : Theme.border-soft;
                background: persona-tom.has-hover ? Theme.graphite-raised : Theme.canvas;

                Text {
                    x: 20px;
                    y: 18px;
                    width: parent.width - 40px;
                    height: 24px;
                    text: "Tom";
                    color: Theme.paper;
                    font-family: "Segoe UI Variable Display";
                    font-size: 17px;
                    font-weight: 650;
                }

                Text {
                    x: 20px;
                    y: 50px;
                    width: parent.width - 40px;
