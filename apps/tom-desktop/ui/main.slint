                border-color: root.selected-persona == "friendly" ? Theme.lavender : Theme.border-soft;
                background: persona-tomy.has-hover ? Theme.graphite-raised : Theme.canvas;

                Text {
                    x: 20px;
                    y: 18px;
                    width: parent.width - 40px;
                    height: 24px;
                    text: "Tomy";
                    color: Theme.paper;
                    font-family: "Segoe UI Variable Display";
                    font-size: 17px;
                    font-weight: 650;
                }

                Text {
                    x: 20px;
                    y: 50px;
                    width: parent.width - 40px;
                    height: 18px;
                    text: "Cercano · chill · alentador";
                    color: Theme.lavender;
                    font-size: 10px;
                    font-weight: 600;
                }

                Text {
                    x: 20px;
                    y: 82px;
                    width: parent.width - 40px;
                    height: 52px;
                    text: "El mismo criterio y privacidad, con una voz más cálida para acompañar tu ritmo diario.";
                    color: Theme.text-tertiary;
                    font-size: 11px;
                    wrap: word-wrap;
                }

                Text {
                    x: 20px;
                    y: 144px;
                    width: parent.width - 40px;
                    height: 16px;
                    text: root.selected-persona == "friendly" ? "SELECCIONADO" : "ELEGIR TOMY";
                    color: root.selected-persona == "friendly" ? Theme.paper : Theme.text-muted;
                    font-size: 9px;
                    font-weight: 700;
                    letter-spacing: 1px;
                }

                persona-tomy := TouchArea {
                    accessible-role: radio-button;
                    accessible-label: "Elegir personalidad Tomy, amigable";
                    clicked => {
                        root.selected-persona = "friendly";
                        root.assistant-name = "Tomy";
                    }
                }
            }

            Text {
                x: 32px;
                y: 400px;
                width: 330px;
                height: 32px;
                text: "Local primero · acciones con aprobación\nPuedes cambiar esto más tarde";
                color: Theme.text-muted;
                font-size: 9px;
                vertical-alignment: center;
            }

            QuietButton {
                x: parent.width - 166px;
                y: 399px;
                width: 134px;
                label: "Entrar como " + root.assistant-name;
                primary: true;
                clicked => {
                    root.persona-selected(root.selected-persona);
                    root.onboarding-visible = false;
                }
            }

            Hairline {
                x: 32px;
                y: 452px;
                width: parent.width - 64px;
