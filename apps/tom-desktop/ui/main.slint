            Text {
                x: 32px;
                y: 461px;
                width: parent.width - 64px;
                height: 16px;
                text: "Built with Slint";
                color: Theme.text-muted;
                font-size: 8px;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
        }
